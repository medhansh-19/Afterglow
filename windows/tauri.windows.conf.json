{
  "$schema": "https://schema.tauri.app/config/2",
  "mainBinaryName": "afterglow-windows",
  "identifier": "local.medhansh.afterglow.windows",
  "bundle": {
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
