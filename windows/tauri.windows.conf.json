{
  "$schema": "https://schema.tauri.app/config/2",
  "version": "0.2.1",
  "mainBinaryName": "afterglow-windows",
  "identifier": "local.medhansh.afterglow.windows",
  "bundle": {
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "installerHooks": "../../windows/generated/installer-hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhGMkYzNTlFQUQ2M0Q4NzgKUldSNDJHT3RualV2ajAxVmlXOVVpMDdJTWNha1VXS1ZTVC9Wd1VPNUttTTdYamV1cjB4YmNrcEIK",
      "endpoints": [
        "https://github.com/medhansh-19/Afterglow/releases/download/windows-updates/windows-latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Afterglow",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "backgroundColor": "#09090b",
        "maximized": true
      }
    ]
  }
}
