          "English"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "version": "0.2.0",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhGMkYzNTlFQUQ2M0Q4NzgKUldSNDJHT3RualV2ajAxVmlXOVVpMDdJTWNha1VXS1ZTVC9Wd1VPNUttTTdYamV1cjB4YmNrcEIK",
      "endpoints": [
        "https://github.com/medhansh-19/Afterglow/releases/download/windows-updates/windows-latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
