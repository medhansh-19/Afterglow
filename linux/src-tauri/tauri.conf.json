{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Afterglow",
  "version": "0.2.0",
  "identifier": "local.medhansh.afterglow.linux",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Afterglow",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "backgroundColor": "#09090b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "externalBin": [
      "binaries/afterglow-lyrics"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "libgtk-layer-shell0",
          "pulseaudio-utils",
          "libcurl4t64",
          "fonts-noto-core",
          "fonts-noto-color-emoji",
          "pkexec"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "icon": [
      "icons/icon.png"
    ],
    "resources": {
      "runtime/": "runtime/",
      "notices/": "notices/"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhGMkYzNTlFQUQ2M0Q4NzgKUldSNDJHT3RualV2ajAxVmlXOVVpMDdJTWNha1VXS1ZTVC9Wd1VPNUttTTdYamV1cjB4YmNrcEIK",
      "endpoints": [
        "https://github.com/medhansh-19/Afterglow/releases/download/linux-updates/linux-latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
